generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum AdminRole {
  SUPER_ADMIN
  ADMIN
  EDITOR
}

enum DownloadStatus {
  SUCCESS
  FAILED
}

enum PlatformKey {
  facebook
  youtube
  instagram
  tiktok
}

model AdminUser {
  id             String    @id @default(cuid())
  supabaseUserId String?   @unique
  email          String    @unique
  name           String?
  role           AdminRole @default(ADMIN)
  isActive       Boolean   @default(true)
  lastLoginAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@map("admin_users")
}

model Language {
  id         String        @id @default(cuid())
  code       String        @unique // e.g., "en", "bn", "id", "es"
  name       String // e.g., "English", "Bengali", "Indonesian", "Spanish"
  nativeName String // e.g., "English", "বাংলা", "Bahasa Indonesia", "Español"
  hreflang   String // e.g., "en", "bn", "id", "es"
  direction  String        @default("ltr") // "ltr" or "rtl"
  isDefault  Boolean       @default(false)
  isActive   Boolean       @default(true)
  sortOrder  Int           @default(0)
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
  contents   PageContent[]

  @@index([isActive, sortOrder])
  @@map("languages")
}

model PageContent {
  id               String   @id @default(cuid())
  languageId       String
  language         Language @relation(fields: [languageId], references: [id], onDelete: Cascade)
  pageSlug         String // "home" | "facebook" | "youtube" | "instagram" | "tiktok" | "youtube-transcript"
  heroTitle        String
  heroSubtitle     String   @db.Text
  placeholder      String
  featuresSubtitle String   @default("") @db.Text
  features         Json     @default("[]") // Array<{ title: string; description: string }>
  guideBadge       String   @default("")
  guideTitle       String   @default("")
  guideParagraphs  Json     @default("[]") // string[]
  supportedFormats Json     @default("[]") // string[]
  howToSteps       Json     @default("[]") // Array<{ title: string; description: string }>
  faqs             Json     @default("[]") // Array<{ question: string; answer: string }>
  seoTitle         String
  seoDescription   String   @db.Text
  seoKeywords      Json     @default("[]") // string[]
  ogTitle          String
  ogDescription    String   @db.Text
  ogImageUrl       String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([languageId, pageSlug])
  @@index([pageSlug])
  @@map("page_contents")
}

model DownloadLog {
  id           String         @id @default(cuid())
  platform     PlatformKey
  videoUrl     String         @db.Text
  status       DownloadStatus
  errorMessage String?        @db.Text
  errorCode    String?
  quality      String?
  locale       String         @default("en")
  createdAt    DateTime       @default(now())

  @@index([createdAt])
  @@index([platform, status])
  @@index([status, createdAt])
  @@map("download_logs")
}

model PlatformConfig {
  id         String      @id @default(cuid())
  platform   PlatformKey @unique
  isEnabled  Boolean     @default(true)
  cookies    String?     @db.Text
  proxyUrl   String?
  userAgent  String?
  statusNote String?
  updatedAt  DateTime    @updatedAt

  @@map("platform_configs")
}

model GlobalSettings {
  id                 String   @id @default("singleton")
  siteName           String   @default("Save Vibe")
  logoUrl            String   @default("/favicons/search-logo-96.png")
  faviconUrl         String   @default("/favicon.ico")
  defaultOgImage     String   @default("/og-image.png")
  headScripts        String   @default("") @db.Text
  bodyScripts        String   @default("") @db.Text
  maintenanceMode    Boolean  @default(false)
  maintenanceMessage String   @default("We are upgrading Save Vibe for faster downloads. Please check back shortly.") @db.Text
  updatedAt          DateTime @updatedAt

  @@map("global_settings")
}
