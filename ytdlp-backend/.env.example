# Required secret shared with Next.js frontend (X-API-Key header)
YTDLP_API_SECRET=change-this-to-a-strong-random-secret

# Optional comma-separated allowed CORS origins (default: *)
ALLOWED_ORIGINS=*

# Optional: Base64 encoded Netscape cookies.txt (helpful if Instagram rate-limits datacenter IPs)
# Example: base64 -w 0 cookies.txt
YTDLP_COOKIES_B64=
